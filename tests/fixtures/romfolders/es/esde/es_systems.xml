<?xml version="1.0"?>
<systemList>
    <system>
        <name>psx</name>
        <path>%ROMPATH%/psx</path>
        <extension>.cue .CUE .chd .CHD</extension>
        <command label="Beetle PSX">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%/mednafen_psx_libretro.so %ROM%</command>
        <command label="DuckStation (Standalone)">%EMULATOR_DUCKSTATION% -batch %ROM%</command>
    </system>
    <system>
        <name>model2</name>
        <path>%ROMPATH%/model2</path>
        <extension>.zip</extension>
        <command label="MAME">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%/mame_libretro.so %ROM%</command>
    </system>
    <system>
        <name>tanodragon</name>
        <path>%ROMPATH%/tanodragon</path>
        <extension>.cas .CAS</extension>
        <command label="MAME [Tape] (Standalone)">%EMULATOR_MAME% -rompath %GAMEDIR%\;%ROMPATH%/dragon32 tanodr64 -cass %ROM%</command>
        <!-- <command label="MAME Legacy (Standalone)">%EMULATOR_MAME% -rompath %GAMEDIR%\;%ROMPATH%/tanodragon tanodr64 -cass %ROM%</command> -->
    </system>
    <system>
        <name>arcade</name>
        <path>%ROMPATH%/arcade</path>
        <extension>.zip .ZIP</extension>
        <command label="MAME - Current">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%/mame_libretro.so "%BASENAME% -rompath \"%GAMEDIRRAW%;%ROMPATH%/arcade\""</command>
        <command label="MAME (Standalone)">%EMULATOR_MAME% -rompath %GAMEDIR%\;%ROMPATH%/arcade %BASENAME%</command>
    </system>
</systemList>
