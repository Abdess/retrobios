QUAD_WIDTH 16
CHARSET_REGISTRY "ISO10646"
CHARSET_ENCODING "-1"
CHARSET_COLLECTIONS "ASCII ISO8859-5 GB2312.1980 BIG5-0 KSC5601.1989-0 JISX0208.1997 ISO10646-1"
ENDPROPERTIES
