    "intro.lvlx": {
        "events": [
            {
                "i": 4,
                "msg": "Добро пожаловать в наш мир, странник!",
                "orig": "Welcome to our World, Stranger!"
            },
            {
                "i": 5,
                "msg": "Пожалуйста, проследуйте за указателями, чтобы войти в мир и начать ваше приклю-\nчение.",
                "orig": "Please follow arrow pointers to enter the world to start your adventure here!"
            },
            {
                "i": 6,
                "msg": "Чтобы входить в двери и говорить с персонажами, нажмите кнопку ВВЕРХ, стоя перед дверью или перед персонажем, у которого виден восклицательный знак.",
                "orig": "To enter doors or talk to an NPC, press the UP key while you are in front of a door or an NPC with an exclamation mark."
            },
            {
                "i": 8,
                "msg": "Эй, кто-то убил бандита! Это спасение!",
                "orig": "Hey, you just killed a bandit! You saved us!"
            },
            {
                "i": 9,
                "msg": "Добро пожаловать к нам! Ты, кажется, наш Мессия! У нас очень большая беда: наше королевство было захвачено беспощадным Мистером Хеллом, он послал против нас свою огромную армию! Мы устали от них! Пожалуйста, спаси наше королевство от зла!",
                "orig": "Welcome to us! You are probably our Messiah! We have very big trouble: our kingdom was seized by the merciless Mr. Hell, sending his huge army against us! We are tired of them! Please save our kingdom from the Evil!"
            },
            {
                "i": 11,
                "msg": "Приветствую, и добро пожаловать в игру! Данная инструкция расскажет об основных персонажах и поможет адаптировать управление, и познакомиться с основами.",
                "orig": "Hello, and welcome to the game! This instruction will explain the main characters, allow you to adapt controles (SIC), and see some basics."
            },
            {
                "i": 12,
                "msg": "",
                "orig": "This is Demo, an armless cycloptic demon, alien minion, and command center operator.",
                "u": true
            }
        ],
        "npc": [
            {
                "i": 0,
                "orig": "Huh? I was silent ... What am I doing here? I'm waiting for when they let me go home ... What is the voice here? Are you sure you're not crazy? Here in the hall there is absolute silence.",
                "talk": "А? Я молчал как мышь ... Что я здесь делаю? Я жду, когда мне разрешат вер-\nнуться домой ... Что за голос тут? У тебя точно всё с головой в порядке? В этом зале абсолютная гро-\nбовая тишина."
            },
            {
                "i": 4,
                "orig": "Do you still don't know how to enter pipes? Just press DOWN while you standing on it.",
                "talk": "Ты до сих пор не знаешь, как залезать в трубы? Просто нажми ВНИЗ, стоя на трубе."
            },
            {
                "i": 6,
                "orig": "Enter this door to take the basic tutorial, or go forward to begin the adventure!",
                "talk": "Войди в эту дверь, чтобы пройти базовое обучение, или беги вперёд, чтобы начать приключение!"
            },
            {
                "i": 8,
                "orig": "Please use this telephone to take tips: press JUMP while you standing under it.",
                "talk": "",
                "u": true
            },
            {
                "i": 10,
                "orig": "Please grab this blue block and throw it up. Press DOWN while standing on it, and press RUN button to grab it. Then, press UP key and release the RUN button to throw the block up.",
                "talk": "",
                "u": true
            }
        ],
        "title": "Введение",
        "title-orig": "Intro"
    },
