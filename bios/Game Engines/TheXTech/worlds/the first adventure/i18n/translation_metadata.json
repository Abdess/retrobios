        "events": [
            {
                "i": 4,
                "msg": "Welcome to our World, Stranger!",
                "trig": 5
            },
            {
                "by-event": [
                    4
                ],
                "i": 5,
                "msg": "Please follow arrow pointers to enter the world to start your adventure here!"
            },
            {
                "i": 6,
                "msg": "To enter doors or talk to an NPC, press the UP key while you are in front of a door or an NPC with an exclamation mark."
            },
            {
                "i": 8,
                "msg": "Hey, you just killed a bandit! You saved us!",
                "trig": 9
            },
            {
                "by-event": [
                    8
                ],
                "i": 9,
                "msg": "Welcome to us! You are probably our Messiah! We have very big trouble: our kingdom was seized by the merciless Mr. Hell, sending his huge army against us! We are tired of them! Please save our kingdom from the Evil!"
            },
            {
                "i": 11,
                "msg": "Hello, and welcome to the game! This instruction will explain the main characters, allow you to adapt controles (SIC), and see some basics."
            },
            {
                "i": 12,
                "msg": "This is Demo, an armless cycloptic demon, alien minion, and command center operator."
            }
        ],
        "npc": [
            {
                "i": 0,
                "t": 94,
                "talk": "Huh? I was silent ... What am I doing here? I'm waiting for when they let me go home ... What is the voice here? Are you sure you're not crazy? Here in the hall there is absolute silence."
            },
            {
                "i": 4,
                "t": 151,
                "talk": "Do you still don't know how to enter pipes? Just press DOWN while you standing on it."
            },
            {
                "i": 6,
                "t": 94,
                "talk": "Enter this door to take the basic tutorial, or go forward to begin the adventure!"
            },
            {
                "i": 8,
                "t": 94,
                "talk": "Please use this telephone to take tips: press JUMP while you standing under it."
            },
            {
                "i": 10,
                "t": 151,
                "talk": "Please grab this blue block and throw it up. Press DOWN while standing on it, and press RUN button to grab it. Then, press UP key and release the RUN button to throw the block up."
            }
        ],
        "title": "Intro"
    },
