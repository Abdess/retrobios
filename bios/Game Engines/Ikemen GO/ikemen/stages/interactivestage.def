; Definition of Interactive Stage
; This stage adds Attached Chars
; The term "background" is used to mean both backgrounds and foregrounds.
; Licensed under CC BY 3.0.

; ----------------------------------------------------------
[Info]
name = "Interactive Training Stage"							; Internal name of the stage.
displayName = "Interactive Training Stage"					; Name to display on the select screen.
versionDate = 2026.01.22									; Version / Date of stage.
ikemenVersion = 1.0											; Version of Ikemen GO the stage is made for.
author = "Lasombra Demon, Phantom.of.the.Server"			; Stage author name.
attachedChar = interactivestage/interactivestageChar.def	; Location of attached character's DEF file.
;AttachedChar2 = AnotherAttachedChar.def					; Location of another character's DEF file,
															; you can have up to 4.
; ----------------------------------------------------------
[Camera]
; Camera starting position: Usually 0 for both
startX = 0
startY = 0

; Left and right bounds of camera
; You may want to fiddle a bit with these values to make sure the
; background doesn't move too far or too little
boundLeft = -30;
boundRight = 30;

; High and low bound of camera
; High is a negative number. Make it more negative if you want to
; camera to be able to move higher.
; Low should usually be 0.
; If omitted, defaults to -25 and 0 respectively
boundHigh = -240
boundLow = 0

; Horizontal distance player is from edge before camera starts to move
; left or right. Typically 50 or 60.
tension = 50

; These parameters control the distance between the highest and lowest
; characters where the camera will begin to move or zoom out
tensionhigh = 120
tensionlow = 0

; Number of pixels beyond the top and bottom of the screen that may
; be drawn.  Overdraw specifies the how much can be seen during an
; EnvShake.  Overdraw pixels will also be used when the screen aspect
; is taller than the stage aspect.
overdrawhigh = 50
overdrawlow = 50

; Number of pixels into the top and bottom of the screen that may be
; cut from drawing when the screen aspect is shorter than the stage
; aspect.  These parameters suggest a guideline, and the actual
; number of pixels cut depends on the difference in aspect.
cuthigh = 60
cutlow = 0

; Zoom parameters
startzoom = 1.00
zoomout = 0.75
zoomin = 1.00

; ----------------------------------------------------------
[PlayerInfo]
; --- Player 1 ---
; Player 1 starting coordinates.
; p1StartX is typically -70 and p2startx is 70.
; p1StartY should be 0.
p1StartX = -70          ;Starting x coordinates
p1StartY = 0            ;Starting y coordinates
p1Facing = 1            ;Direction player faces: 1=right, -1=left

; --- Player 2 ---
p2StartX = 70
p2StartY = 0
p2Facing = -1

; --- Common ---
; Absolute limit that any player can move on the X axis.
; These values should be larger than boundLeft and boundRight
leftBound = -1000
rightBound =  1000

; ----------------------------------------------------------
[Bound]
; Distance from left/right edge of screen that players can move to.
; Typically 15
screenLeft = 30
screenRight = 30

; ----------------------------------------------------------
[StageInfo]
; "Ground" level where players stand at, measured in pixels from the top of the screen.
; Adjust this value to move the ground level up or down in the screen.
zoffset = 200

; Leave this at 1. It makes the players automatically face each other
autoturn = 1

; Set the following to 1 to have the background reset itself between rounds.
resetBG = 1

; Width and height of the local coordinate space of the stage.
localCoord = 320, 240

; Scale of the stage portrait in the select screen
portraitScale = 1.0

;  Horizontal and vertical scaling factor for drawing.
xScale = 1
yScale = 1

; ----------------------------------------------------------
[Shadow]
; This is the shadow darkening intensity. Valid values range from
; 0 (lightest) to 256 (darkest). Defaults to 128 if omitted.
intensity = 128

; This is the shadow color given in r,g,b. Valid values for each
; range from 0 (lightest) to 255 (darkest).
; Defaults to "0, 0, 0" if omitted.
; intensity and color's effects add up to give the final shadow result.
color = 16, 16, 0

; This is the scale factor of the shadow. Use a big scale factor
; to make the shadow longer. You can use a NEGATIVE scale factor
; to make the shadow fall INTO the screen.
; Defaults to 0.4 if omitted.
yScale = -0.25

; This parameter lets you set the range over which the shadow is
; visible. The first value is the high level, and the second is
; the middle level. Both represent y-coordinates of the player.
; A shadow is invisible if the player is above the high level,
; and fully visible if below the middle level. The shadow is
; faded in between the two levels. This gives an effect of the
; shadow fading away as the player gets farther away from the
; ground. If omitted, defaults to no level effects (shadow is
; always fully visible).
fade.range = -120, 0

offset = 0, 0

; ----------------------------------------------------------
[Reflection]
; Intensity of reflection (from 0 to 256).
; Set to 0 to have no reflection. Defaults to 0.
intensity = 64

; See shadow color
color = 202, 202, 256

; See shadow yScale
yScale = 0.67

offset = 0, 0

; ----------------------------------------------------------
[Music]
; Put a filename for a MOD, MP3 or MIDI here, or just leave it
; blank if you don't want music. If an invalid filename is
; given, then no music will play.
bgMusic =

; bgmLoopstart = <sample number>
; bgmloopend = <sample number>

 ;Adjust the volume. 100 is for 100%.
bgmVolume = 100

; ==========================================================

; ----------------------------------------------------------
; Background definition
; ----------------------------------------------------------
; [BG x]
; type = ?       "Normal"/"Parallax"  (def: "normal")
; spriteNo = ?, ? Sprite group and number: groupno, imgno  (req'd)
; start = ?, ?   Starting location (integer)  (def: 0, 0)
; delta = ?, ?   Change in location per camera unit moved (float)  (def: 1,1)
; trans = ?      Transparency settings: "none"/"add"/"add1"/"sub"" (def: "none")
; mask = ?       Masking (int): 0 - off, 1 - on  (def: 0)
; velocity = ?, ? Velocity: x, y (float): speed background moves (def: 0, 0)
; tile = ?, ?    Tiling: xtile, ytile (int): 0 - off, 1 - infinite,
;                        >1 - tile that number of times  (def: 0, 0) - only for Normal BG
; tilespacing = ?, ? Tiling: x, y (int) : space between tiles (def: 0, 0)
;
;  Parallax-only:
; xScale = ?, ?    Top xscale, bottom xscale (float)
; width = ?, ?     Top width, bottom width (int)  (use either this or above, but not both)
; yScaleStart = ?  Starting y-scale (float, in percent)  (def: 100)
; yScaleDelta = ?  Change in y-scale per unit (float, in percent)  (def: 0)
; ----------------------------------------------------------

; For more information check the stage docs.

; ----------------------------------------------------------
; Main background definition
[BGdef]
; Filename of sprite data.
spr = interactivestage.sff

; Set to 1 if you want to clear the screen to magenta before
; drawing layer 0 (the default background).
; Good for spotting "holes" in your background.
; Remember to turn this off when you are done debugging the background,
; because it slows down performance.
debugBg = 0

[BG Colour]
type = normal
spriteNo = 1, 1
layerNo = -1
start = 0, 0
delta = 1, 1
tile = 1, 0
tileSpacing = 0, 0
mask = 0
ID = 1

[BG BackWallGrid]
type = normal
spriteNo = 1, 0
layerNo = -1
start = 0, -12
delta = 0.6, 0.6
tile = 1, 1
tileSpacing = 0, 0
mask = 1
layerno = -1
scalestart = 0.8,0.8
ID = 2

[BG BackBannerMature]
type = normal
spriteNo = 5, 1
layerNo = -1
start = 0, 57
delta = 0.6, 0.6
mask = 1
ID = 51
scalestart = 0.65,0.45
trans=addalpha
alpha = 0,256

[BG BackBannerTeen]
type = normal
spriteNo = 5, 0
layerNo = -1
start = 0, 57
delta = 0.6, 0.6
mask = 1
ID = 50
scalestart = 0.65,0.45
trans=addalpha
alpha = 0,256

[BG WallWithHole]
type = normal
spriteNo = 3, 2
layerNo = 0
start = 0, -12
delta = 0.8667, 1
tileSpacing = 0, 0
mask = 1
layerno = 0
tile = 1, 1
tileSpacing = 0, 0
ID = 3

[BG WallWithHoleGrid]
type = normal
spriteNo = 4, 2
layerNo = 0
start = 0, -12
delta = 0.8667, 1
tileSpacing = 0, 0
mask = 1
layerno = 0
tile = 1, 1
tileSpacing = 0, 0
ID = 3

[BG Floor]
type = parallax
spriteno = 0, 0
layerno = 0
start = 0, 160
delta = 0.8667, 1.0
tile = 1, 0
tilespacing = 0, 0
width = 43, 63.15
mask = 0
ID = 4

[BG FloorFront]
type = parallax
spriteno = 0, 2
layerno = 0
start = 0, 160
delta = 0.8667, 1.0
tile = 1, 0
tilespacing = 0, 0
width = 43, 63.15
mask = 0
ID = 4

[BG ColumnLeft]
type  = anim
actionno = 0
layerNo = 0
start = -230, 200
delta = 1, 1
mask = 1
ID = 101

[BG ColumnLeftReflection]
type = normal
spriteNo = 3, 0
layerNo = 0
start = -230, 350
delta = 1, 1
mask = 1
trans = addalpha
alpha = 128,128
ID = 201

[BGCtrlDef Left]
looptime = -1;No loop reset
CTRLID=201;-> SAME AS ID IN BG ELEMENT
[BGCtrl ReflectionRight]
type=Enable
time=1,99999,-1
value=1
SCTRLID=301;-> SAME AS NUMBER IN ATTACHEDCHAR SCTRL

[BG ColumnRight]
type  = anim
actionno = 0
layerNo = 0
start = 230, 200
delta = 1, 1
mask = 1
ID = 102

[Begin Action 0];Healthy Pillar 
0,1, 0,0, -1

[Begin Action 1];Broken Pillar 
-1,-1, 0,0, -1

[BG ColumnRightReflection]
type = normal
spriteNo = 3, 0
layerNo = 0
start = 230, 350
delta = 1, 1
mask = 1
trans = addalpha
alpha = 128,128
ID = 202

[BGCtrlDef Right]
looptime = -1;No loop reset
CTRLID=202;-> SAME AS ID IN BG ELEMENT
[BGCtrl ReflectionRight]
type=Enable
time=1,99999,-1
value=1
SCTRLID=302;-> SAME AS NUMBER IN ATTACHEDCHAR SCTRL

[BG Window]
type = normal
spriteNo = 3, 1
layerNo = 0
start = 0, 11800
delta = 0.8667, 1
mask = 1
scalestart = 0.5,0.5
trans = addalpha
alpha = 196,196
scalestart = 0.5,0.5

[BG WindowReflection]
