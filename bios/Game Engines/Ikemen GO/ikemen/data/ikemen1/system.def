; Definitions of system screens

; Motif: IKEMEN1 with 24 Slots
; Optimal resolution: 1280x720
; Supported languages: en, ja

; Notes about fonts:
;   - fonts can be specified in the [Files] section (no limit to how many),
;     alternatively, you can point directly to the file path in the parameter:
;     i.e: menu.item.font = font/menu1.def, 0, -1
;   - fonts indexed here do not refer to the ones in fight.def
;   - fonts are search in directories in the following order:
;     1. system directory
;     2. ikemen program directory (not recommended to keep custom fonts here)
;     3. data/ (not recommended to keep custom fonts here)
;     4. font/

;----------------------------
[Info]
name = IKEMEN1              ;Name of motif
author = Ohmga Shironeko    ;Motif author name
versiondate = 03,06,2026    ;Version date of motif (MM-DD-YYYY) (new in MUGEN 1.0)
ikemenversion = 1.0         ;Version of I.K.E.M.E.N motif is compatible with (Ikemen nightly)
localcoord = 1280,720       ;Local coordinate space width and height (new in MUGEN 1.0)

;----------------------------
;Directories are checked in this order:
;1. current directory system.def is in
;2. data/
;3. your Ikemen directory
;eg. If you write "spr = system.sff", and this system.def file
;    is in ~/ikemen/data/mymotif/, then Ikemen will first look
;    for ~/ikemen/data/mymotif/system.sff. If it does not find
;    it there, it looks for ~/ikemen/data/system.sff (the default).
;    Finally, if that is not found, it will look for
;    ~/ikemen/system.sff.

[Files]
spr = system.sff            ;Filename of sprite data
snd = system.snd            ;Filename of sound data
logo.storyboard = logo.def  ;Logo storyboard definition (optional)
;intro.storyboard =         ;Intro storyboard definition (optional)
select = select.def         ;Character and stage selection list
fight = fight.def           ;Fight definition filename
font1 = f-4x6.def
font2 = ikemen1/fonts/Pixel.def
font3 = ikemen1/fonts/Menu2.def
font4 = ikemen1/fonts/Menu1.def
font5 = Open_Sans.def
;font5.height = 36          ;Uncomment to override the size of the font (Truetype fonts only)
font6 = infofont.def
font7 = Open_Sans.def
font8 = ikemen1/fonts/Timer.def
font9 = ikemen1/fonts/PixelFlat.def
module =                    ;External Lua code

;----------------------------
[Music]
 ;Put a filename for a MOD, MP3 or MIDI here, or just leave it
 ;blank if you do not want music. If an invalid filename is
 ;given, then no music will play.
 ;To play mymusic.mp3 from the sound/ directory, put:
 ;  title.bgm = sound/mymusic.mp3
 ;Music will continue to play between screens if the files names
 ;are the same, and both BGMs are specified to loop.
  ;Music to play at title screen.
title.bgm = sound/Title.mp3
title.bgm.volume = 100    ;volume scaling factor in percent. 100 is default
title.bgm.loop = 1        ;Set to 0 to prevent looping
title.bgm.loopstart = 
title.bgm.loopend = 
  ;Music to play at char select screen.
select.bgm = sound/Select.mp3
select.bgm.volume = 100
select.bgm.loop = 1
select.bgm.loopstart = 
select.bgm.loopend = 
  ;Music to play at versus screen.
vs.bgm = sound/Versus.mp3
vs.bgm.volume = 100
vs.bgm.loop = 0
vs.bgm.loopstart = 
vs.bgm.loopend = 
  ;Music to play at victory screen.
victory.bgm = sound/Winner.mp3
victory.bgm.volume = 100
victory.bgm.loop = 0
victory.bgm.loopstart = 
victory.bgm.loopend = 
  ;Music to play at option screen.
option.bgm = 
option.bgm.volume = 100
option.bgm.loop = 1
option.bgm.loopstart = 
option.bgm.loopend = 
  ;Music to play at replay screen.
replay.bgm = 
replay.bgm.volume = 100
replay.bgm.loop = 1
replay.bgm.loopstart = 
replay.bgm.loopend = 
  ;Music to play at continue screen.
continue.bgm = sound/Continue.mp3
continue.bgm.volume = 100
continue.bgm.loop = 0
continue.bgm.loopstart = 
continue.bgm.loopend = 
  ;Music to play at results screen.
results.bgm = 
results.bgm.volume = 100
results.bgm.loop = 1
results.bgm.loopstart = 
results.bgm.loopend = 
  ;Music to play at hiscore screen.
hiscore.bgm = 
hiscore.bgm.volume = 100
hiscore.bgm.loop = 1
hiscore.bgm.loopstart = 
hiscore.bgm.loopend = 

