;-------------------------------------------------------------------
;Game over screen definition
[Game Over Screen]
enabled = 1               ;Set to 1 to show game over screen, 0 to disable
storyboard = gameover.def ;Game over storyboard filename

;-------------------------------------------------------------------
;Victory screen definition
;This is the screen that is shown when you win a match in arcade mode.
;It will not be displayed on the last match of arcade mode.
[Victory Screen]
enabled = 1
sounds.enabled = 0        ;Set to 0 to disable char sounds during Victory Screen
time = 360                ;Time to show screen
fadein.time = 8
fadeout.time = 15
;Winner's portrait and name
p1.offset = 150, 80
p1.spr = 9000,2
p1.layerno = 2
p1.facing = 1
p1.scale = 0.8,0.8
p1.window = 0,94, 1279,500
p1.name.offset = 40,570
p1.name.font = 3,3,1
p1.name.layerno = 2
p1.applypal = 1
;Loser's Portrait
p2.offset = 1130, 80
p2.spr = 9000,2
p2.layerno = 1
p2.facing = -1
p2.scale = 0.8,0.8
p2.window = 0,94, 1279,500
p2.applypal = 1
p2.lose.brightness = 75
;Win quote text
winquote.text = Winner! ;Default win quote text to show
winquote.layerno = 2
winquote.offset = 40,615
winquote.textspacing = 0
winquote.font = 5,0,1
winquote.window = 38,521, 1241,708
winquote.textwrap = w   ;Word wrap
winquote.textdelay = 2

