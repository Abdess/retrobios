msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Authentication failed.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"АУТЕНТИФИКАЦИЯ НЕ УДАЛАСЬ.\n"
"СВЯЖИТЕСЬ С АДМИНИСТРАТОРАМИ СЕРВЕРА ЧТОБЫ ПОЛУЧИТЬ БОЛЬШЕ ИНФОРМАЦИИ."

#: Sources/Main.cpp:1564
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Invalid password specified."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"УКАЗАН НЕДОПУСТИМЫЙ ПАРОЛЬ."

#: Sources/Main.cpp:1565
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Invalid player name specified.\n"
"Please check your profile and try it again."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"УКАЗАНО НЕДОПУСТИМОЕ ИМЯ ИГРОКА.\n"
"ПРОВЕРЬТЕ ВАШ ПРОФИЛЬ И ПОПРОБУЙТЕ ЕЩЕ РАЗ."

#: Sources/Main.cpp:1566
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"This client is not in the server whitelist.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"ВАШ КЛИЕНТ НЕ УКАЗАН В БЕЛОМ СПИСКЕ СЕРВЕРА.\n"
"СВЯЖИТЕСЬ С АДМИНИСТРАТОРАМИ СЕРВЕРА ЧТОБЫ ПОЛУЧИТЬ БОЛЬШЕ ИНФОРМАЦИИ."

#: Sources/Main.cpp:1567
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Server requires 3rd party authentication provider.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ТРЕБУЕТ АУТЕНТИФИКАЦИИ ОТ СТОРОННЕГО ПОСТАВЩИКА АУТЕНТИФИКАЦИИ.\n"
"СВЯЖИТЕСЬ С АДМИНИСТРАТОРАМИ СЕРВЕРА ЧТОБЫ ПОЛУЧИТЬ БОЛЬШЕ ИНФОРМАЦИИ."

#: Sources/Main.cpp:1568
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Server capacity is full.\n"
"Please try it later."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ЗАПОЛНЕН.\n"
"ПОПРОБУЙТЕ ПОЗЖЕ."

#: Sources/Main.cpp:1569
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Server is not in a state where it can process your request.\n"
"Please try again in a few seconds."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР НЕ МОЖЕТ ОБРАБОТАТЬ ВАШ ЗАПРОС.\n"
"ПОПРОБУЙТЕ СНОВА ЧЕРЕЗ НЕСКОЛЬКО СЕКУНД."

#: Sources/Main.cpp:1570
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down.\n"
"Please try it later."
msgstr ""
"\f[c:#704a4a]СОЕДИНЕНИЕ БЫЛО ЗАКРЫТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВЫКЛЮЧАЕТСЯ.\n"
"ПОПРОБУЙТЕ ЕЩЕ РАЗ ПОЗЖЕ."

#: Sources/Main.cpp:1571
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down for maintenance.\n"
"Please try it again later."
msgstr ""
"\f[c:#704a4a]СОЕДИНЕНИЕ БЫЛО ЗАКРЫТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВЫКЛЮЧАЕТСЯ НА ТЕХОБСЛУЖИВАНИЕ.\n"
"ПОПРОБУЙТЕ ПОДКЛЮЧИТЬСЯ ПОЗЖЕ."

#: Sources/Main.cpp:1572
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down for reconfiguration.\n"
"Please try it again later."
msgstr ""
"\f[c:#704a4a]СОЕДИНЕНИЕ БЫЛО ЗАКРЫТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВЫКЛЮЧАЕТСЯ НА РЕКОНФИГУРАЦИЮ.\n"
"ПОПРОБУЙТЕ ПОДКЛЮЧИТЬСЯ ПОЗЖЕ."

#: Sources/Main.cpp:1573
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down for update.\n"
"Please check your client version and try it again in a minute."
msgstr ""
"\f[c:#704a4a]СОЕДИНЕНИЕ БЫЛО ЗАКРЫТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВЫКЛЮЧАЕТСЯ НА ОБНОВЛЕНИЕ.\n"
"ПОЖАЛУЙСТА ПРОВЕРЬТЕ ВЕРСИЮ ВАШЕГО КЛИЕНТА И ПОПРОБУЙТЕ ЕЩЕ РАЗ ЧЕРЕЗ МИНУТУ."

#: Sources/Main.cpp:1574
msgid ""
"\f[c:#704a4a]Connection has been lost!\f[/c]\n"
"\n"
"\n"
"Please try it again and if the problem persists,\n"
"check your network connection."
msgstr ""
"\f[c:#704a4a]СОЕДИНЕНИЕ БЫЛО ПОТЕРЯНО!\f[/c]\n"
"\n"
"\n"
"ПОПРОБУЙТЕ ЕЩЕ РАЗ, И ЕСЛИ ПРОБЛЕМА НЕ УХОДИТ,\n"
"ПРОВЕРЬТЕ ВАШЕ ИНТЕРНЕТ СОЕДИНЕНИЕ."

#: Sources/Main.cpp:1575
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"The server is not responding for connection request."
msgstr ""
"\f[c:#704a4a]НЕВОЗМОЖНО ПОДКЛЮЧИТСЯ К СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР НЕ ОТВЕЧАЕТ НА ЗАПРОС ПОДКЛЮЧЕНИЯ."

#: Sources/Main.cpp:1576
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"You have been \f[c:#907050]kicked\f[/c] off the server.\n"
