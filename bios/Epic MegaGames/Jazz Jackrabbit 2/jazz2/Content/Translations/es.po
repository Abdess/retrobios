msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Welcome to Burrowsville\n"
"Please drive carefully."
msgstr ""
"\n"
"Bienvenido a Burrowsville\n"
"Conduce con precaución."

#: .fake/Translations/xmas99/03_xmas3.j2l.h:4
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"That bridge doesnt\n"
"look too safe..."
msgstr ""
"\n"
"Este puente no parece\n"
"muy seguro..."

#: .fake/Translations/xmas99/03_xmas3.j2l.h:5
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Robert and Craig:\n"
"Springs RULE! :)"
msgstr ""
"\n"
"Robert y Craig:\n"
"¡Los trampolines son lo MÁXIMO! :)"

#: .fake/Translations/xmas99/03_xmas3.j2l.h:6
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Now leaving Burrowsville\n"
"Please visit again."
msgstr ""
"\n"
"Abandonando Burrowsville\n"
"Visítanos de nuevo."

#: .fake/Translations/xmas99/03_xmas3.j2l.h:7
msgctxt "xmas99/03_xmas3"
