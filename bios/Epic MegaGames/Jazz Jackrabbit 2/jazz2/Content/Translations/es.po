msgctxt "xmas99/01_xmas1"
msgid ""
"\n"
"Some blocks can only\n"
"be broken with a\n"
"certain weapon."
msgstr ""
"\n"
"Algunos bloques sólo\n"
"se pueden romper con\n"
"una determinada arma."

