msgctxt "xmas99/01_xmas1"
msgid ""
"\n"
"You can buttstomp through\n"
"some of the weakspots\n"
"in the pathways!"
msgstr ""
"\n"
"¡Puedes machacar con el culo\n"
"algunos de los puntos débiles\n"
"en los caminos!"

