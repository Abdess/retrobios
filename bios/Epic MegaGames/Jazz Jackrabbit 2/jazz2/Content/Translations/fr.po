#: Sources/Main.cpp:1570
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down.\n"
"Please try it later."
msgstr ""
"\f[c:#704a4a]La connexion a été interrompue !\f[/c]\n"
"\n"
"\n"
"Le serveur s'arrête.\n"
"Essayez à nouveau plus tard."

