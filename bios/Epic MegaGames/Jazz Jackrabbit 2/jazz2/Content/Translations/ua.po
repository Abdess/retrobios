"\n"
"ВКАЗАНО НЕДІЙСНИЙ ПАРАМЕТР."

#: Sources/Main.cpp:1560
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Your client version is not compatible with the server."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"ВЕРСІЯ ЦЬОГО КЛІЄНТУ НЕ СУМІСНА З СЕРВЕРОМ."

#: Sources/Main.cpp:1561
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"The client was rejected due to malformed communication protocol."
msgstr ""

#: Sources/Main.cpp:1562
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"The connection was denied by the web browser.\n"
"One of the reasons may be connecting to an unsecured WebSocket."
msgstr ""

#: Sources/Main.cpp:1563
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Authentication failed.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"ПОМИЛКА АУТЕНТИФІКАЦІЇ.\n"
"ЗВЕРНІТЬСЯ ДО АДМІНІСТРАТОРІВ СЕРВЕРУ ДЛЯ ОТРИМАННЯ ДОДАТКОВОЇ ІНФОРМАЦІЇ."

#: Sources/Main.cpp:1564
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Invalid password specified."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"ВКАЗАНО НЕДІЙСНИЙ ПАРОЛЬ."

#: Sources/Main.cpp:1565
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Invalid player name specified.\n"
"Please check your profile and try it again."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"ВКАЗАНО НЕДІЙСНЕ ІМ'Я ГРАВЦЯ.\n"
"ПЕРЕВІРТЕ СВІЙ ПРОФІЛЬ ТА СПРОБУЙТЕ ЩЕ РАЗ."

#: Sources/Main.cpp:1566
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"This client is not in the server whitelist.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"ЦЕЙ КЛІЕНТ НЕ ВХОДИТЬ ДО БІЛОГО СПИСКУ СЕРВЕРА.\n"
"ЗВЕРНІТЬСЯ ДО АДМІНІСТРАТОРІВ СЕРВЕРУ ДЛЯ ОТРИМАННЯ ДОДАТКОВОЇ ІНФОРМАЦІЇ."

#: Sources/Main.cpp:1567
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Server requires 3rd party authentication provider.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВИМАГАЄ ВИКОРИСТАННЯ СТОРОННЬОГО ПОСТАЧАЛЬНИКА АУТЕНТИФІКАЦІЇ.\n"
"ЗВЕРНІТЬСЯ ДО АДМІНІСТРАТОРІВ СЕРВЕРУ ДЛЯ ОТРИМАННЯ ДОДАТКОВОЇ ІНФОРМАЦІЇ."

#: Sources/Main.cpp:1568
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Server capacity is full.\n"
"Please try it later."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ПЕРЕПОВНЕНИЙ.\n"
"СПРОБУЙТЕ ПІЗНІШЕ."

#: Sources/Main.cpp:1569
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"Server is not in a state where it can process your request.\n"
"Please try again in a few seconds."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР НЕ МОЖЕ ОБРОБИТИ ВАШ ЗАПИТ НА ДАНИЙ МОМЕНТ.\n"
"СПРОБУЙТЕ ЩЕ РАЗ ЧЕРЕЗ КІЛЬКА СЕКУНД."

#: Sources/Main.cpp:1570
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down.\n"
"Please try it later."
msgstr ""
"\f[c:#704a4a]З'ЄДНАННЯ БУЛО ЗАКРИТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВИМИКАЄТЬСЯ.\n"
"СПРОБУЙТЕ ПІЗНІШЕ."

#: Sources/Main.cpp:1571
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down for maintenance.\n"
"Please try it again later."
msgstr ""
"\f[c:#704a4a]З'ЄДНАННЯ БУЛО ЗАКРИТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВИМИКАЄТЬСЯ ДЛЯ ТЕХНІЧНОГО ОБСЛУГОВУВАННЯ.\n"
"СПРОБУЙТЕ ЩЕ РАЗ ПІЗНІШЕ."

#: Sources/Main.cpp:1572
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down for reconfiguration.\n"
"Please try it again later."
msgstr ""
"\f[c:#704a4a]З'ЄДНАННЯ БУЛО ЗАКРИТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВИМИКАЄТЬСЯ ДЛЯ РЕКОНФІГУРАЦІЇ.\n"
"СПРОБУЙТЕ ЩЕ РАЗ ПІЗНІШЕ."

#: Sources/Main.cpp:1573
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"Server is shutting down for update.\n"
"Please check your client version and try it again in a minute."
msgstr ""
"\f[c:#704a4a]З'ЄДНАННЯ БУЛО ЗАКРИТО!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР ВИМИКАЄТЬСЯ ДЛЯ ОНОВЛЕННЯ.\n"
"ПЕРЕВІРТЕ ВЕРСІЮ ЦЬОГО КЛІЄНТУ ТА СПРОБУЙТЕ ЩЕ РАЗ ЧЕРЕЗ ХВИЛИНУ."

#: Sources/Main.cpp:1574
msgid ""
"\f[c:#704a4a]Connection has been lost!\f[/c]\n"
"\n"
"\n"
"Please try it again and if the problem persists,\n"
"check your network connection."
msgstr ""
"\f[c:#704a4a]ЗВ'ЯЗОК З СЕРВЕРОМ ВТРАЧЕНО!\f[/c]\n"
"\n"
"\n"
"СПРОБУЙТЕ ЩЕ РАЗ, І ЯКЩО ПРОБЛЕМА НЕ ЗНИКНЕ,\n"
"ПЕРЕВІРТЕ ІНТЕРНЕТ З'ЄДНАННЯ."

#: Sources/Main.cpp:1575
msgid ""
"\f[c:#704a4a]Cannot connect to the server!\f[/c]\n"
"\n"
"\n"
"The server is not responding for connection request."
msgstr ""
"\f[c:#704a4a]НЕМОЖЛИВО ПІДКЛЮЧИТИСЯ ДО СЕРВЕРУ!\f[/c]\n"
"\n"
"\n"
"СЕРВЕР НЕ ВІДПОВІДАЄ НА ЗАПИТИ ПІДКЛЮЧЕННЯ."

#: Sources/Main.cpp:1576
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"You have been \f[c:#907050]kicked\f[/c] off the server.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]З'ЄДНАННЯ БУЛО ЗАКРИТО!\f[/c]\n"
"\n"
"\n"
"ВИ БУЛИ \f[c:#907050]ВИГНАНІ\f[/c] З СЕРВЕРА.\n"
"ЗВЕРНІТЬСЯ ДО АДМІНІСТРАТОРІВ СЕРВЕРУ ДЛЯ ОТРИМАННЯ ДОДАТКОВОЇ ІНФОРМАЦІЇ."

#: Sources/Main.cpp:1577
msgid ""
"\f[c:#704a4a]Connection has been closed!\f[/c]\n"
"\n"
"\n"
"You have been \f[c:#725040]banned\f[/c] off the server.\n"
"Contact server administrators for more information."
msgstr ""
"\f[c:#704a4a]З'ЄДНАННЯ БУЛО ЗАКРИТО!\f[/c]\n"
"\n"
"\n"
"ВИ БУЛИ \f[c:#725040]ЗАБЛОКОВАНІ\f[/c] НА СЕРВЕРІ.\n"
"ЗВЕРНІТЬСЯ ДО АДМІНІСТРАТОРІВ СЕРВЕРУ ДЛЯ ОТРИМАННЯ ДОДАТКОВОЇ ІНФОРМАЦІЇ."

