msgctxt "xmas99/01_xmas1"
msgid ""
"\n"
"You can buttstomp through\n"
"some of the weakspots\n"
"in the pathways!"
msgstr ""
"\n"
"Con una schiacciata del didietro\n"
"puoi passare attraverso alcuni\n"
"punti deboli del percorso!"

