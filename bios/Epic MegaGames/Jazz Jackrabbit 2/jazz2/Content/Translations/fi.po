msgctxt "secretf/09_town3"
msgid ""
"\n"
"Choose a cover and stomp away!"
msgstr ""
"\n"
"Valitse suojasi ja pyllähdä pois!"

#: .fake/Translations/secretf/09_town3.j2l.h:5
msgctxt "secretf/09_town3"
msgid ""
"\n"
