msgctxt "xmas99/01_xmas1"
msgid ""
"\n"
"Some blocks can only\n"
"be broken with a\n"
"certain weapon."
msgstr ""
"\n"
"Jotkin palikat voi rikkoa\n"
"vain tietyllä aseella."

