"\n"
"Älä menetä otettasi!"

#: .fake/Translations/xmas99/03_xmas3.j2l.h:3
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Welcome to Burrowsville\n"
"Please drive carefully."
msgstr ""
"\n"
"Tervetuloa Burrowsvilleen\n"
"Aja varovasti."

#: .fake/Translations/xmas99/03_xmas3.j2l.h:4
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"That bridge doesnt\n"
"look too safe..."
msgstr ""
"\n"
"Tuo silta ei vakuta\n"
"kovin turvalliselta..."

#: .fake/Translations/xmas99/03_xmas3.j2l.h:5
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Robert and Craig:\n"
"Springs RULE! :)"
msgstr ""
"\n"
"Rubert ja Craig:\n"
"Jouset RULETTAA! :)"

#: .fake/Translations/xmas99/03_xmas3.j2l.h:6
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Now leaving Burrowsville\n"
"Please visit again."
msgstr ""
"\n"
"Poistut Burrowsvillestä\n"
"Tervetuloa uudelleen."

#: .fake/Translations/xmas99/03_xmas3.j2l.h:7
msgctxt "xmas99/03_xmas3"
msgid ""
"\n"
"Password: xmasbunny\n"
"Please visit\n"
"www.project2.com"
msgstr ""
"\n"
"Salasana: xmasbunny\n"
"Vieraile sivulla\n"
"www.project2.com"

