"Goto www.project2.com\n"
"use\n"
"password: BUNNYLOVER\n"
msgstr ""
"\n"
"Mene www.project2.com\n"
"käytä\n"
"salasanaa: BUNNYLOVER\n"

#: .fake/Translations/share/01_share1.j2l.h:1
