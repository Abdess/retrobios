msgctxt "share/03_share3"
msgid ""
"\n"
"You made it! This is the end\n"
" of the shareware version.\n"
"Now check out the order info\n"
"for M O R E!"
msgstr ""
"\n"
"Sinä teit sen! Tämä on\n"
"ilmaisversion loppu.\n"
"Tarkista tilausohjeet\n"
"kokoversiota varten!"

