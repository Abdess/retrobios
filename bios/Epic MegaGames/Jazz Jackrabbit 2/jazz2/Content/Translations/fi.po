msgctxt "secretf/09_town3"
msgid ""
"\n"
"BEWARE! Flocks of Ravens can\n"
"be very dangerous."
msgstr ""
"\n"
"VAROITUS! Korppilaumat voivat\n"
"olla hyvin vaarallisia."

