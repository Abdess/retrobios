msgctxt "secretf/07_town1"
msgid ""
"\n"
"Jump as far over to the\n"
"right as you possibly can..."
msgstr ""
"\n"
"Hyppää niin pitkälle vasemmalle\n"
"kuin vain suinkin voit...."

